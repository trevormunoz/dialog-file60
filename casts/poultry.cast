[48.967,"o","\r\n     various   levels  of  zinc  and  copper.  J.  Nutr.  Biochem."]
[49.517,"o","\r\n     3:140-145.  PIMENTEL, J.L., COOK, M.E. and GREGER, J.L. 1992."]
[50.067,"o","\r\n     Anemia  induced  by  ingestion  of  excess  zinc  in  chicks:"]
[50.617,"o","\r\n     Importance  of  red  blood  cell  turnover. J. Nutr. Biochem."]
[51.167,"o","\r\n     3:146-150.  ORTH,  M.W., BAI, Y., ZEYTUN, I.H. and COOK, M.E."]
