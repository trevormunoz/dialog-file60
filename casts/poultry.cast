[44.567,"o","\r\n     70:1637-1639.  PIMENTEL,  J.L.,  COOK, M.E. and JONSSON, J.M."]
[45.117,"o","\r\n     1991.  Research  Note:  Increased growth of chicks and poults"]
[45.667,"o","\r\n     obtained  from  hens  injected  with jackbean urease. Poultry"]
[46.217,"o","\r\n     Sci. 70:1842-1844. WU, W., COOK, M.E. and SMALLEY, E.B. 1991."]
[46.767,"o","\r\n     Decreased  immune  response and increased incidence of tibial"]
