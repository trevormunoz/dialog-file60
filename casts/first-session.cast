[21.367,"o","\r\n"]
[21.9,"o","\r\n PRIMARY HEADINGS: R304 Biological Efficiency-Fruit, Vegetables;"]
[22.433,"o","\r\n R307 Biological Efficiency-Field Crops; A4900 Biology of Plants"]
[22.942,"o","\r\n and Animals; A5000 Biological Efficiency of Plants, Animals;"]
[23.483,"o","\r\n C1000 Deciduous and Small Fruits and Nuts; C2300 Soybeans; C2600"]
